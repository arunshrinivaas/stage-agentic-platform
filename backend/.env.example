# Google Gemini & Agent Development Kit (ADK) Configuration
# Required for live agentic execution with Google Gemini models.
# If omitted or invalid, the backend automatically falls back to offline deterministic mode.
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Identifier
# Supported values: gemini-2.5-flash, gemini-2.5-pro
STAGE_AI_MODEL=gemini-2.5-flash

# SQLite Database Location
# Defaults to backend/stage.db if left unset
DATABASE_PATH=./stage.db

